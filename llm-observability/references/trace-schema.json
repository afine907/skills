{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Agent Decision Trace",
  "description": "AI Agent 单步决策追踪记录的 JSON Schema",
  "type": "object",
  "required": ["trace_id", "session_id", "step_number", "timestamp", "input", "llm_call", "decision", "output"],
  "properties": {
    "trace_id": {
      "type": "string",
      "description": "唯一追踪ID，格式：uuid 或 session_id-step_number"
    },
    "session_id": {
      "type": "string",
      "description": "会话ID，关联同一会话的所有步骤"
    },
    "step_number": {
      "type": "integer",
      "minimum": 1,
      "description": "当前步骤编号（从1开始）"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "步骤执行时间（ISO 8601）"
    },
    "input": {
      "type": "object",
      "description": "步骤输入信息",
      "properties": {
        "context_tokens": {
          "type": "integer",
          "description": "输入上下文的 Token 数"
        },
        "context_utilization": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "上下文窗口利用率（0-1）"
        },
        "user_message": {
          "type": "string",
          "description": "用户输入（如果是用户触发的步骤）"
        },
        "relevant_history_steps": {
          "type": "array",
          "items": { "type": "integer" },
          "description": "被引用的历史步骤编号"
        }
      }
    },
    "llm_call": {
      "type": "object",
      "description": "LLM 调用详情",
      "required": ["model", "input_tokens", "output_tokens", "latency_ms"],
      "properties": {
        "model": {
          "type": "string",
          "description": "使用的模型标识"
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 0,
          "description": "输入 Token 数"
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0,
          "description": "输出 Token 数"
        },
        "latency_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "LLM 响应延迟（毫秒）"
        },
        "cost_usd": {
          "type": "number",
          "minimum": 0,
          "description": "本次调用成本（美元）"
        },
        "cached_tokens": {
          "type": "integer",
          "minimum": 0,
          "description": "缓存命中的 Token 数"
        }
      }
    },
    "decision": {
      "type": "object",
      "description": "Agent 决策信息",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["tool_call", "text_response", "clarification", "error", "end"],
          "description": "决策类型"
        },
        "tool_name": {
          "type": "string",
          "description": "调用的工具名称（type=tool_call 时）"
        },
        "tool_params": {
          "type": "object",
          "description": "工具调用参数（type=tool_call 时）"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "决策置信度（0-1，可选）"
        },
        "reasoning": {
          "type": "string",
          "description": "决策推理过程（可选）"
        }
      }
    },
    "tool_execution": {
      "type": "object",
      "description": "工具执行详情（type=tool_call 时）",
      "properties": {
        "latency_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "工具执行延迟（毫秒）"
        },
        "success": {
          "type": "boolean",
          "description": "工具执行是否成功"
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0,
          "description": "工具返回内容的 Token 数"
        },
        "error": {
          "type": "string",
          "description": "错误信息（失败时）"
        },
        "error_type": {
          "type": "string",
          "enum": ["timeout", "rate_limit", "auth_error", "validation_error", "service_unavailable", "unknown"],
          "description": "错误类型"
        },
        "retry_count": {
          "type": "integer",
          "minimum": 0,
          "description": "重试次数"
        }
      }
    },
    "output": {
      "type": "object",
      "description": "步骤输出信息",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["tool_result", "text_response", "error", "end"],
          "description": "输出类型"
        },
        "tokens": {
          "type": "integer",
          "minimum": 0,
          "description": "输出 Token 数"
        }
      }
    },
    "context_health": {
      "type": "object",
      "description": "上下文健康状态",
      "properties": {
        "total_tokens_used": {
          "type": "integer",
          "description": "累计使用的 Token 数"
        },
        "window_utilization": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "当前上下文窗口利用率"
        },
        "compression_events": {
          "type": "integer",
          "minimum": 0,
          "description": "上下文压缩/摘要的次数"
        },
        "oldest_context_age_steps": {
          "type": "integer",
          "minimum": 0,
          "description": "最旧上下文距今的步骤数"
        }
      }
    },
    "metadata": {
      "type": "object",
      "description": "自定义元数据",
      "additionalProperties": true
    }
  }
}
